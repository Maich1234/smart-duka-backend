{
 "version": 2,
 "builds": [
  {
   "src": "index.js",
   "use": "@vercel/node"
  }
 ],
 "routes": [
  {
   "src": "/(.*)",
   "dest": "index.js"
  }
 ],
 "crons": [
  {
   "path": "/api/v1/cron/daily-sales-check",
   "schedule": "0 17 * * *"
  },
  {
   "path": "/api/v1/cron/depletion-alerts",
   "schedule": "30 6 * * *"
  },
  {
   "path": "/api/v1/cron/daily-summary",
   "schedule": "30 18 * * *"
  },
  {
   "path": "/api/v1/cron/subscription-reminders",
   "schedule": "0 7 * * *"
  },
  {
   "path": "/api/v1/cron/push-campaign-dispatch",
   "schedule": "0 9 * * *"
  },
  {
   "path": "/api/v1/cron/subscription-payment-reconcile",
   "schedule": "0 8 * * *"
  },
  {
   "path": "/api/v1/cron/account-deletions",
   "schedule": "0 3 * * *"
  }
 ]
}
